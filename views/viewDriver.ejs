<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Driver Details</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Driver Details</h1>
  <a href="/">Back to Menu</a>

  <% if (!driver) { %>
    <p>No driver found.</p>
  <% } else { %>
    <table>
      <tr><th>ID</th><td><%= driver.driverID %></td></tr>
      <tr><th>Name</th><td><%= driver.fName %> <%= driver.lName %></td></tr>
      <tr><th>Phone</th><td><%= driver.telNo %></td></tr>
      <tr><th>Email</th><td><%= driver.email %></td></tr>
      <tr><th>Availability</th><td><%= driver.availabilityStatus %></td></tr>
      <tr><th>License</th>
        <td>
          No: <%= driver.licenseNo %>,
          Type: <%= driver.licenseType %>,
          Exp: <%= driver.expiryDate.toISOString().slice(0,10) %>
        </td>
      </tr>
      <tr><th>Contract</th>
        <td>
          ID: <%= driver.contractID %>,
          Start: <%= driver.contractStartDate.toISOString().slice(0,10) %>,
          End: <%= driver.contractEndDate.toISOString().slice(0,10) %>
        </td>
      </tr>
      <tr><th>Hub</th>
        <td>Hub <%= driver.hubID %> - <%= driver.city %>, <%= driver.province %></td>
      </tr>
    </table>
  <% } %>
</body>
</html>
