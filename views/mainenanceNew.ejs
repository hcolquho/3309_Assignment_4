<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Record Maintenance</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Record Vehicle Maintenance Activity</h1>
  <a href="/">Back to Menu</a>

  <% if (message) { %>
    <p class="message"><%= message %></p>
  <% } %>

  <form method="post" action="/maintenance/new">
    <fieldset>
      <legend>Vehicle</legend>
      <label>Vehicle:
        <select name="vehicleID" required>
          <% vehicles.forEach(v => { %>
            <option value="<%= v.vehicleID %>">
              <%= v.make %> <%= v.model %> (ID <%= v.vehicleID %>)
            </option>
          <% }) %>
        </select>
      </label>
    </fieldset>

    <fieldset>
      <legend>Maintenance Info</legend>
      <label>Type:
        <input type="text" name="maintenanceType" required>
      </label><br>
      <label>Cost:
        <input type="number" step="0.01" name="cost">
      </label><br>
      <label>Service Provider:
        <input type="text" name="serviceProvider">
      </label><br>
      <label>Description:
        <textarea name="maintenanceDescription"></textarea>
      </label><br>
      <label>Date:
        <input type="date" name="maintenanceDate" required>
      </label><br>
      <label>Time:
        <input type="time" name="maintenanceTime">
      </label><br>
      <label>Vehicle In Service After?
        <input type="checkbox" name="isInService" checked>
      </label>
    </fieldset>

    <button type="submit">Save Maintenance</button>
  </form>
</body>
</html>
